{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/crypto-polyfill.ts",
    "**/browser-shims.ts",
    "**/ssr-storage.ts",
    "**/error-capture.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:build:android": "npm run build && cap sync android",
    "cap:build:ios": "npm run build && cap sync ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:build": "npm run build && cap sync ios",
    "ios:check": "npm run build && npx cap sync ios && node scripts/patch-capacitor-plugins.js && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO clean build",
    "ios:dev": "CAPACITOR_SERVER_URL=http://localhost:8080 cap sync ios && cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:dev": "CAPACITOR_SERVER_URL=http://10.0.2.2:8080 cap sync android && cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "postinstall": "node scripts/patch-capacitor-plugins.js"
  },
  "overrides": {
    "rolldown": "1.2.1",
    "next-themes": "$next-themes",
    "react-day-picker": {
      "date-fns": "$date-fns"
    }
